    "Every page is served from the Internet Archive. Change the date in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Seite wird aus dem Internet Archive geladen. Das Datum lässt sich in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las páginas se sirven desde el Internet Archive. Cambia la fecha en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque page est servie depuis l’Internet Archive. Modifiez la date dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pagina viene servita dall’Internet Archive. Cambia la data nelle Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as páginas vêm do Internet Archive. Altere a data nos Ajustes."
          }
        }
      }
    },
    "Fixes stretched images on sites that size them with CSS, at the cost of some reflow while a page loads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behebt verzerrte Bilder auf Seiten, die Bildgrößen per CSS festlegen — dafür kann sich das Layout während des Ladens verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige las imágenes deformadas en sitios que definen su tamaño con CSS, a costa de cierto reajuste del diseño durante la carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige les images déformées sur les sites qui définissent leur taille en CSS, au prix d’un léger réagencement pendant le chargement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregge le immagini deformate sui siti che ne definiscono le dimensioni con i CSS, al costo di un certo riposizionamento durante il caricamento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige imagens distorcidas em sites que definem o tamanho por CSS, ao custo de algum rearranjo do layout durante o carregamento."
          }
        }
      }
    },
    "From a UTM guest on the emulated network, use %@." : {
      "localizations" : {
        "de" : {
