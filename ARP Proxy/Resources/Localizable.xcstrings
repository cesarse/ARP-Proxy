    "Fixes stretched images on sites that size them with CSS, at the cost of some reflow while a page loads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behebt verzerrte Bilder auf Seiten, die Bildgrößen per CSS festlegen — dafür kann sich das Layout während des Ladens verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige las imágenes deformadas en sitios que definen su tamaño con CSS, a costa de cierto reajuste del diseño durante la carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige les images déformées sur les sites qui définissent leur taille en CSS, au prix d’un léger réagencement pendant le chargement."
          }
        }
      }
    },
