    "Pages come from the Internet Archive's copy closest to the date below; the guest browser still sees the original addresses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten stammen aus der Kopie des Internet Archive, die dem unten gewählten Datum am nächsten liegt; der Gast-Browser sieht weiterhin die ursprünglichen Adressen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas vienen de la copia del Internet Archive más cercana a la fecha de abajo; el navegador del invitado sigue viendo las direcciones originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages proviennent de la copie de l’Internet Archive la plus proche de la date ci-dessous ; le navigateur de l’invité voit toujours les adresses d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine provengono dalla copia dell’Internet Archive più vicina alla data qui sotto; il browser del guest vede ancora gli indirizzi originali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas vêm da cópia do Internet Archive mais próxima da data abaixo; o navegador do convidado continua vendo os endereços originais."
          }
        }
      }
    },
    "Pages the guest browser has cached may still show the previous date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten im Cache des Gast-Browsers können noch das vorherige Datum zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas en la caché del navegador del invitado pueden seguir mostrando la fecha anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages en cache dans le navigateur de l’invité peuvent encore afficher la date précédente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine nella cache del browser del guest possono mostrare ancora la data precedente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páginas em cache no navegador do convidado ainda podem mostrar a data anterior."
          }
        }
      }
    },
